{
  "name": "syllabus-station",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -n app,db -c cyan,green \"pnpm run dev:client\" \"pnpm run prisma:dev\"",
    "dev:client": "nodemon -w src/server -x tsx src/server/main.ts",
    "prepare": "husky",
    "prisma:dev": "prisma dev",
    "prisma:generate": "prisma generate",
    "start": "NODE_ENV=production tsx src/server/main.ts"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@coursetable/passport-cas": "^0.1.4",
    "@mantine/core": "^9.6.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/form": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.103.2",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "fuzzysort": "^4.0.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^20.1.3",
    "react-error-boundary": "^6.1.6",
    "react-pdf": "^11.0.0",
    "react-router": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-express": "*"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.2",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "multer": "^2.5.0",
    "nodemon": "^3.1.10",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prisma": "^7.10.0",
    "vite": "^8.3.3",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
